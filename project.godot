; Engine configuration file.
config_version=5

[application]

config/name="Quantos Dias?"
config/description="Idle cozy numa faixa da tela: um homem num bunker, um rádio e uma promessa."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon/icon_256.png"
config/windows_native_icon="res://assets/icon/icon.ico"
run/low_processor_mode=false
config/use_custom_user_dir=true
config/custom_user_dir_name="QuantosDias"

[audio]

buses/default_bus_layout="res://assets/audio/bus_layout.tres"
driver/enable_input=false

[autoload]

Settings="*res://scripts/platform/settings.gd"
I18n="*res://scripts/i18n/i18n.gd"
Game="*res://scripts/sim/game.gd"
WindowService="*res://scripts/platform/window_service.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"

[display]

window/size/viewport_width=344
window/size/viewport_height=88
window/size/borderless=true
window/size/resizable=false
window/energy_saving/keep_screen_on=false
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/subwindows/embed_subwindows=true

[physics]

common/physics_ticks_per_second=10

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0784314, 0.0666667, 0.0588235, 1)
